{
  "experiments": {
    "toy_15_state_convergence": {
      "description": "Analytic 15-state CTMC experiment from Section 6.1 / Appendix D.1: high-order samplers should converge faster in KL than first-order tau-leaping under the same step budget.",
      "weight": 1.0,
      "primary_metric": "convergence_order",
      "metrics": {
        "convergence_order": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "kl_at_max_steps": {
          "higher_is_better": false,
          "coefficient": -1.0
        },
        "max_steps": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "mean_rejection_rate": {
          "higher_is_better": false,
          "coefficient": -0.1
        },
        "positive_intensity_fraction": {
          "higher_is_better": true,
          "coefficient": 0.2
        }
      },
      "results": {
        "tau_leaping": {
          "type": "baseline",
          "convergence_order": 1.0,
          "max_steps": 128
        },
        "theta_rk2": {
          "type": "proposed",
          "convergence_order": 2.0,
          "max_steps": 128
        },
        "theta_trapezoidal": {
          "type": "proposed",
          "convergence_order": 2.0,
          "max_steps": 128
        }
      }
    }
  }
}
